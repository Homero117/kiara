# Copia este archivo como .env y pega tus claves después del signo =

# Clave de la API de Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-opus-5-5. Más barato: claude-haiku-5-5
# KIARA_MODELO=claude-opus-5-5

# --- Voz de ElevenLabs (opcional) ---
# elevenlabs.io -> Developers -> API Keys (permisos: Text to Speech y Voices: read)
ELEVENLABS_API_KEY=
# Nombre de la voz a buscar en "My Voices" (por defecto Liz)
# ELEVENLABS_VOZ=Liz
# O el ID directo de la voz:
# ELEVENLABS_VOICE_ID=
# Modelo: eleven_multilingual_v2 (mejor calidad) o eleven_flash_v2_5 (más rápido)
# ELEVENLABS_MODELO=eleven_multilingual_v2
